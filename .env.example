# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# (Project Settings -> API Keys). A publishable key é feita para ficar no app;
# a segurança dos dados vem das regras de acesso em supabase/schema.sql.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
